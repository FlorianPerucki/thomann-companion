{
  "manifest_version": 3,
  "name": "Thomann Price Companion",
  "description": "Shows the Thomann price next to products on the current page. Off by default; enable per page with the toolbar button.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "webNavigation"],
  "host_permissions": [
    "https://www.thomannmusic.ch/*",
    "https://www.thomannmusic.com/*",
    "https://www.thomann.fr/*",
    "https://www.thomann.de/*",
    "https://www.leboncoin.fr/*",
    "https://www.ricardo.ch/*",
    "https://www.anibis.ch/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": [
      "content/util.js",
      "content/adapters/ricardo.js",
      "background/matcher.js",
      "background/thomann-client.js",
      "background/marketplaces.js",
      "background/background.js"
    ]
  },
  "action": {
    "default_title": "Thomann prices: click to enable on this page",
    "default_icon": {
      "16": "icons/off.svg",
      "32": "icons/off.svg",
      "48": "icons/off.svg"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/on.svg",
    "96": "icons/on.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thomann-companion@fpki.me",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
